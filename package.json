{
  "name": "inversiones360-chat",
  "productName": "Inversiones 360 CHAT",
  "version": "1.15.4",
  "description": "Asistente de ventas por WhatsApp con IA",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "@hapi/boom": "^10.0.1",
    "qrcode": "^1.5.4",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.4.5",
    "groq-sdk": "^0.7.0",
    "openai": "^4.68.0",
    "electron": "^31.0.0",
    "fluent-ffmpeg": "^2.1.2",
    "ffmpeg-static": "^5.2.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.inversiones360.chat",
    "productName": "Inversiones 360 CHAT",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "**/*",
      "!session/**",
      "!tmp/**",
      "!node-portable/**",
      "!*.bak-*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Inversiones 360 CHAT"
    }
  }
}